{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Bookmark Backup API",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "bookmark_backup.web.app:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Frontend (Vite)",
      "type": "pwa-node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Full stack (API + React)",
      "configurations": ["Bookmark Backup API", "Frontend (Vite)"],
      "stopAll": true,
      "presentation": {
        "order": ["Bookmark Backup API", "Frontend (Vite)"]
      }
    }
  ]
}
